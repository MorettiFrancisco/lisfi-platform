{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lisfi-api-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-22",
  "workers_dev": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lisfi-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
}
